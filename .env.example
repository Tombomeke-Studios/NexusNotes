DATABASE_URL=postgres://nexus:nexus_dev@localhost:5432/nexus_notes?sslmode=disable
JWT_SECRET=change-me-to-a-random-string
# Encrypts user data at rest: 64 hex characters (openssl rand -hex 32).
# Development-only key, shared on purpose so every dev setup can read the
# same dev data. Never use it in production: .env.production.example leaves
# it empty so a real deployment must generate its own. Never change it
# without moving the old one to DATA_ENCRYPTION_OLD_KEYS.
DATA_ENCRYPTION_KEY=c544855c1ee05f092c90b9d443f3802a56442f2822fc77a314a6ece9905b66fd
REDIS_URL=redis://localhost:6379
PORT=8080
# Comma-separated listen addresses (default: every interface; keep unset in Docker)
# BIND_ADDR=127.0.0.1,::1
# Per-IP rate limit on /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=10
# Browser origins for CORS + the WebSocket handshake (comma separated).
# Empty = desktop app + local dev defaults; setting it replaces them.
CORS_ALLOWED_ORIGINS=
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
