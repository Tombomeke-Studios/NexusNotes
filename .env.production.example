# Settings for the production stack (docker-compose.yml). Copy this file to
# .env and fill in every REQUIRED value: `docker compose` refuses to start
# while one is empty. Generate each secret separately, for example with
#   openssl rand -hex 32

# REQUIRED: signs sign-in sessions. At least 32 random characters.
JWT_SECRET=
# REQUIRED: password of the database user. Only applied when the database
# volume is created; docs/deployment.md explains how to change it later.
POSTGRES_PASSWORD=
# REQUIRED: Meilisearch master key (search). At least 16 characters.
MEILI_MASTER_KEY=
# REQUIRED: MinIO root password (attachment storage).
MINIO_ROOT_PASSWORD=
# MINIO_ROOT_USER=nexus_minio

# Public origin of the web UI, used in the links of emails.
APP_BASE_URL=http://localhost:3000
# Host port the web UI is published on.
# NEXUS_HTTP_PORT=3000

# Optional: enables /api/admin/* for `Authorization: Bearer <token>`.
# At least 32 random characters; leave empty to keep the endpoints disabled.
ADMIN_TOKEN=

# Optional email (verification and password reset); empty SMTP_HOST disables it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: extra browser origins for CORS and WebSockets (comma separated).
CORS_ALLOWED_ORIGINS=

# Only for docker-compose.monitoring.yml:
# GRAFANA_PASSWORD=
